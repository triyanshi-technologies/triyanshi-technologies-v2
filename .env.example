# Copy to .env.local for local development. The NEXT_PUBLIC_* values are public
# identifiers (also set in the CI workflow); the token is secret.

# Sanity project (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=eb7crcip
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# Optional: external API server for forms/tools (defaults to the production server)
# NEXT_PUBLIC_API_BASE=https://triyanshi-technologies-server.vercel.app

# SECRET — Sanity Editor token, only needed for `npm run sanity:import`.
SANITY_API_WRITE_TOKEN=
