{
  "name": "triyanshi-technologies-website",
  "version": "2.0.0",
  "description": "Triyanshi Technologies marketing website - Next.js + Tailwind CSS + Sanity.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/triyanshi-technologies/triyanshi-technologies.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "predev": "node scripts/clear-fetch-cache.mjs && node scripts/optimize-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/clear-fetch-cache.mjs && node scripts/optimize-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs && node scripts/generate-sitemap.mjs && node scripts/check-assets.mjs",
    "images": "node scripts/optimize-images.mjs",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sanity:import": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sanity-import.ts"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
